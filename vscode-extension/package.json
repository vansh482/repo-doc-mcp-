{
  "name": "repo-doc-generator",
  "displayName": "Repo Doc Generator",
  "description": "Generate comprehensive technical and non-technical documentation for your codebase using AI. Powered by MCP.",
  "version": "0.1.0",
  "publisher": "repo-doc-mcp",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Machine Learning",
    "Programming Languages"
  ],
  "keywords": [
    "documentation",
    "mcp",
    "ai",
    "code documentation",
    "technical writing"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:repoDoc.generateDocs",
    "onCommand:repoDoc.generateTechnicalDoc",
    "onCommand:repoDoc.generateNonTechnicalDoc",
    "onCommand:repoDoc.showRepoSummary",
    "onCommand:repoDoc.openSettings",
    "onCommand:repoDoc.viewLastDoc"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "repoDoc.generateDocs",
        "title": "Generate Documentation (Both)",
        "category": "Repo Doc",
        "icon": "$(book)"
      },
      {
        "command": "repoDoc.generateTechnicalDoc",
        "title": "Generate Technical Documentation",
        "category": "Repo Doc",
        "icon": "$(code)"
      },
      {
        "command": "repoDoc.generateNonTechnicalDoc",
        "title": "Generate Non-Technical Guide",
        "category": "Repo Doc",
        "icon": "$(person)"
      },
      {
        "command": "repoDoc.showRepoSummary",
        "title": "Show Repository Summary",
        "category": "Repo Doc",
        "icon": "$(info)"
      },
      {
        "command": "repoDoc.openSettings",
        "title": "Open Settings",
        "category": "Repo Doc",
        "icon": "$(gear)"
      },
      {
        "command": "repoDoc.viewLastDoc",
        "title": "View Last Generated Documentation",
        "category": "Repo Doc",
        "icon": "$(eye)"
      }
    ],
    "configuration": {
      "title": "Repo Doc Generator",
      "properties": {
        "repoDoc.mcpServerPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the repo-doc-mcp server directory. If empty, the extension will look for the server in common locations."
        },
        "repoDoc.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Path to the Python interpreter to use for running the MCP server."
        },
        "repoDoc.llm.provider": {
          "type": "string",
          "enum": ["anthropic", "openai", "ollama"],
          "default": "anthropic",
          "description": "Which LLM provider to use for documentation generation."
        },
        "repoDoc.llm.model": {
          "type": "string",
          "default": "claude-sonnet-4-20250514",
          "description": "The specific model to use (depends on provider). Examples: claude-sonnet-4-20250514, gpt-4o, llama3.1"
        },
        "repoDoc.llm.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key for the LLM provider. Leave empty to use environment variables (ANTHROPIC_API_KEY or OPENAI_API_KEY)."
        },
        "repoDoc.output.directory": {
          "type": "string",
          "default": "./docs/generated",
          "description": "Directory where generated documentation will be saved (relative to workspace root)."
        },
        "repoDoc.output.includeArchitectureDiagram": {
          "type": "boolean",
          "default": true,
          "description": "Include a Mermaid architecture diagram in the technical documentation."
        },
        "repoDoc.autoOpen": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open generated docs in the built-in viewer after generation."
        },
        "repoDoc.watcher.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable background watcher that monitors main branch and auto-updates docs."
        },
        "repoDoc.watcher.intervalMinutes": {
          "type": "number",
          "default": 5,
          "description": "How often (in minutes) the background watcher checks for main branch changes."
        },
        "repoDoc.watcher.autoGenerateBranchDocs": {
          "type": "boolean",
          "default": false,
          "description": "Automatically generate branch-specific docs when switching git branches."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "repoDoc",
          "title": "Repo Documentation",
          "icon": "$(book)"
        }
      ]
    },
    "views": {
      "repoDoc": [
        {
          "id": "repoDocActions",
          "name": "Actions",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "explorer/context": [
        {
          "command": "repoDoc.generateDocs",
          "group": "navigation",
          "when": "explorerResourceIsFolder"
        }
      ],
      "commandPalette": [
        {
          "command": "repoDoc.generateDocs",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "repoDoc.generateTechnicalDoc",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "repoDoc.generateNonTechnicalDoc",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "repoDoc.showRepoSummary",
          "when": "workspaceFolderCount > 0"
        }
      ]
    },
    "keybindings": [
      {
        "command": "repoDoc.generateDocs",
        "key": "ctrl+shift+d",
        "mac": "cmd+shift+d",
        "when": "workspaceFolderCount > 0"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "lint": "eslint src --ext ts",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "@vscode/vsce": "^2.22.0",
    "eslint": "^8.56.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0"
  },
  "dependencies": {}
}
